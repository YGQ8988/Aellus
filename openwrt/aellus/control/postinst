#!/bin/sh
# Aellus —— ipk 安装后脚本。
#
# 内容与 OpenWrt buildroot 为「未自定义 postinst 的包」自动生成的默认脚本完全一致
# （见 include/package-pack.mk），即调用 /lib/functions.sh 的 default_postinst，它负责：
#   1. 执行本包自带的 /etc/uci-defaults/aellus（放行端口），成功后删除该脚本；
#   2. 对本包安装的每个 /etc/init.d/ 脚本执行 enable（开机自启）与 start（立即启动）；
#   3. 清除 /tmp/luci-indexcache，让 LuCI 菜单立刻出现「服务 → Aellus局域网传输」。
# 用官方默认行为，避免自造逻辑与后续系统升级的实现脱节。
# IPKG_INSTROOT 非空表示正在写入离线根目录（如打包固件），此时不启服务。

[ -s "${IPKG_INSTROOT}/lib/functions.sh" ] || exit 0
. "${IPKG_INSTROOT}/lib/functions.sh"

# —— 先恢复用户原有的 UCI 配置 ——
# 必须放在 default_postinst 之前：default_postinst 会把 /etc/uci-defaults/aellus 跑完、
# 再 enable + start 服务，而服务一启动，init 脚本发现 /etc/config/aellus 不存在就会
# 先用默认模板生成一份 —— 那时再想把备份放回去就晚了（文件已存在）。
#
# 老版本的包自带 /etc/config/aellus，而升级时 opkg 会把旧包文件清单里的文件全删掉
# （见 control/prerm 的注释）。prerm 已把它备份到 /tmp/aellus-config.bak，这里放回去，
# 用户改过的端口 / 保存目录就不会丢。全新安装没有备份，跳过即可，交给 init 生成默认配置。
if [ -z "${IPKG_INSTROOT}" ]; then
	if [ -s /tmp/aellus-config.bak ] && [ ! -s /etc/config/aellus ]; then
		mv /tmp/aellus-config.bak /etc/config/aellus 2>/dev/null
		logger -t aellus "升级：已保留原有的 /etc/config/aellus"
	fi
	rm -f /tmp/aellus-config.bak 2>/dev/null
fi

default_postinst $0 $@

# —— LuCI 菜单刷新 ——
# default_postinst 只删了 /tmp/luci-indexcache 这一个名字；而 dispatcher 真正读的是
# /tmp/luci-indexcache.<hash>.json（见 dispatcher.uc 的 build_pagetree）。正常情况下
# 新增 menu.d 文件会让 hash 变化从而重建，这里顺手清干净，并把 ucode 编译缓存一起清掉，
# 避免个别固件/残留文件导致菜单不刷新。仅真机安装时执行（打包固件时 IPKG_INSTROOT 非空）。
if [ -z "${IPKG_INSTROOT}" ]; then
	rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*.json 2>/dev/null
	rm -rf /tmp/luci-modulecache 2>/dev/null
fi

cat <<'EOF'

Aellus 安装完成。

若 LuCI 的「服务」菜单里暂时没有出现「Aellus局域网传输」：
rpcd 的 ACL 访问组是在「登录那一刻」才计算的
（rpcd/session.c 的 rpc_login_setup_acls 在 rpc_handle_login 中 glob /usr/share/rpcd/acl.d），
安装之前就已经存在的 LuCI 会话拿不到 luci-app-aellus 这个组，
LuCI 会据此把菜单项判定为隐藏（dispatcher.uc: apply_tree_acls → satisfied=false）。
刷新页面没有用，请注销后重新登录 LuCI，再按 Ctrl+Shift+R 强刷一次。

EOF
