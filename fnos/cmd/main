#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 通用包（platform=all）同时携带 x86_64 / aarch64 两个二进制，按机器架构选择；
# 兼容旧版单架构包：若找不到对应架构文件且存在 aellus 则回退使用。
MACHINE_ARCH="$(uname -m)"
case "${MACHINE_ARCH}" in
  x86_64|amd64)  BIN="${TRIM_APPDEST}/aellus-x86_64" ;;
  aarch64|arm64) BIN="${TRIM_APPDEST}/aellus-aarch64" ;;
  *)             BIN="${TRIM_APPDEST}/aellus" ;;
esac
if [ ! -x "${BIN}" ] && [ -x "${TRIM_APPDEST}/aellus" ]; then
  BIN="${TRIM_APPDEST}/aellus"
fi

if [ ! -x "${BIN}" ]; then
  echo "二进制不存在或不可执行: ${BIN}" > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi

# 上传文件落盘目录：优先用飞牛声明的共享目录（文件管理器可见），回退到应用数据目录
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "${SHARE_DIR}" ]; then
  SHARE_DIR="${TRIM_PKGVAR}/drops"
fi
mkdir -p "${SHARE_DIR}"

# 端口优先级：向导自定义 > manifest 声明 > 默认 5115
PORT="${wizard_port:-${TRIM_SERVICE_PORT:-5115}}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting Aellus ..."
    log_msg "BIN = ${BIN}"
    log_msg "SHARE_DIR = ${SHARE_DIR}"
    log_msg "PORT = ${PORT}"
    # main.go 不解析命令行参数：保存目录经 AELLUS_SAVE_DIR 注入，端口经 AELLUS_PORT 注入。
    # 飞牛统一网关：把网关 Socket 路径与前缀注入应用，应用据此额外监听网关 Unix Socket，
    # 并在删除/设置接口强制校验网关注入的可信头 X-Trim-Userid（裸端口请求无此头，无法越权）。
    # 注意：Socket 文件名（aellus.sock）须与 app/ui/config 的 gatewaySocket 一致，
    #      前缀须与 gatewayPrefix 一致，否则网关找不到 Socket 或路由 404。
    GATEWAY_SOCKET="${TRIM_APPDEST}/aellus.sock"
    rm -f "${GATEWAY_SOCKET}"   # 清理上次异常退出残留的 Socket，避免 bind 失败
    # gatewayPrefix 必须与 appname（Aellus，含大小写）一致，飞牛才注册网关路由；
    # 应用侧对前缀大小写不敏感，两种写法都能正确剥离。
    FNNAS_GATEWAY_SOCKET="${GATEWAY_SOCKET}" FNNAS_GATEWAY_PREFIX="/app/Aellus" \
    AELLUS_SAVE_DIR="${SHARE_DIR}" AELLUS_PORT="${PORT}" AELLUS_STRICT_PORT=1 "${BIN}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL ${pid}
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    # 清理网关 Socket（下次启动会重建）
    rm -f "${TRIM_APPDEST}/aellus.sock"

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
