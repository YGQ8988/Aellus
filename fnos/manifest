appname               = Aellus
version               = 1.0.4
display_name          = Aellus 局域网传输
desc                  = Aellus — 飞牛 NAS 局域网传输工具<br><br>极简访问：零安装、零流量、无需注册，手机/电脑/平板有浏览器即可直连 NAS 上传、浏览、下载，数据不经过任何中转服务器。<br><br>防误删：独立网页或跨设备访问仅支持浏览与下载；删除文件、修改保存路径需在飞牛应用中心内操作，避免误删。<br><br>安全可控：文件读写严格限定在管理员授权的目录内，不越界；授权目录持久化，重启仍生效。<br><br>隐私保障：仅调用飞牛官方接口获取授权与路径转换，不读写授权外文件，不收集、不上传任何个人信息，所有传输均在局域网完成。
source                = thirdparty
platform              = all
maintainer            = 染洛凉
maintainer_url        = https://github.com/YGQ8988/Aellus
distributor           = 一西啊
distributor_url       = https://space.bilibili.com/320421193
os_min_version        = 1.2.0
desktop_uidir         = ui
desktop_applaunchname = Aellus.Application
service_port          = 5115
# 飞牛统一网关：应用以 Unix Socket 接入网关，门户内请求由网关转发并注入可信头
# X-Trim-Userid；裸 TCP 端口（service_port）保留给局域网设备直连上传。
gatewaySocket         = aellus.sock
gatewayPrefix         = /app/Aellus
checkport             = false
ctl_stop              = true
disable_authorization_path = false
micro_app             = true
changelog             = 1.增加 icns 格式文件预览图\n2.无法预览文件预览图与上传保持一致\n3.飞牛卸载增加是否保留配置选项\n4.若干样式优化
