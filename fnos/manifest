desc                  = <h3>Aellus — 局域网传输</h3><strong>极简访问：</strong>手机 / 电脑 / 平板 通过任何浏览器即可直连 NAS 上传、浏览、下载，数据不经过任何中转服务器。<br><strong>防止误删：</strong>文件读写严格限定在管理员授权的目录内。其他设备仅能浏览与下载，删除或改路径等危险操作都需在飞牛中完成。<br><strong>隐私保障：</strong>授权与路径只通过飞牛官方接口获取，绝不访问授权外内容；不记录不上传个人信息，所有连接仅限局域网内完成。<h4>其他系统可前往Github Releases 页下载对应 Aellus 运行文件</h4>
source                = thirdparty
platform              = all
maintainer            = 染洛凉
maintainer_url        = https://github.com/YGQ8988/Aellus
distributor           = 一西啊
distributor_url       = https://space.bilibili.com/320421193
os_min_version        = 1.2.0401
desktop_uidir         = ui
desktop_applaunchname = Aellus.Application
service_port          = 5115
# 飞牛统一网关：应用以 Unix Socket 接入网关，门户内请求由网关转发并注入可信头
# X-Trim-Userid；裸 TCP 端口（service_port）保留给局域网设备直连上传。
gatewaySocket         = aellus.sock
gatewayPrefix         = /app/Aellus
checkport             = false
ctl_stop              = true
disable_authorization_path = false
micro_app             = true
